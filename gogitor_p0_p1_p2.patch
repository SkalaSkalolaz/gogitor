+	w := New(root)
+	changes := []domain.FileChange{
+		{Path: "first.go", Patches: []domain.Patch{{Search: "func first() {}", Replace: "func first() { println(1) }"}}},
+		{Path: "second.go", Patches: []domain.Patch{{Search: "func missing() {}", Replace: "func missing() { println(2) }"}}},
+	}
+	if err := w.ApplyChangesSmartWithPolicy(root, changes, PatchPolicyStrict, 0); err == nil {
+		t.Fatal("expected transaction to fail")
+	}
+
+	gotFirst, err := os.ReadFile(first)
+	if err != nil {
+		t.Fatal(err)
