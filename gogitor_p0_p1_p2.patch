+			}
+			if raw.ExpectedSymbolFingerprint != "" && strings.TrimSpace(raw.Symbol) != "" {
+				fp, err := SymbolFingerprint(string(before), raw.Symbol)
+				if err != nil {
+					return nil, report, fmt.Errorf("patch %d %s symbol %q: %w", i+1, rel, raw.Symbol, err)
+				}
+				if fp != raw.ExpectedSymbolFingerprint {
+					return nil, report, fmt.Errorf("patch %d %s symbol %q changed since generation", i+1, rel, raw.Symbol)
+				}
+			}
+		}
+
+		for i, raw := range preparedPatches {
+			resolved, err := PreparePatchForContent(content, raw)
+			if err != nil {
+				return nil, report, fmt.Errorf("patch %d %s: %w", i+1, rel, err)
+			}
+			preparedPatches[i] = resolved
+
+			beforePatch := content
+			updated, err := applyOnePatchWithPolicy(content, resolved, policy, minConfidenceOverride)
+			if err != nil {
+				return nil, report, err
+			}
+			added, removed := patchLineStats(resolved.Search, resolved.Replace)
+			patchChangedLines := maxInt(added, removed)
+			fileChangedLines += patchChangedLines
+			fileSearchLines += maxInt(1, len(strings.Split(strings.TrimSpace(resolved.Search), "\n")))
+			report.ChangedLines += patchChangedLines
+			if patchChangedLines > limits.MaxChangedLines {
+				return nil, report, fmt.Errorf("patch %d %s changes too many lines: %d, maximum %d", i+1, rel, maxInt(added, removed), limits.MaxChangedLines)
+			}
+			if len(strings.Split(strings.TrimSpace(resolved.Search), "\n")) > 0 {
+				searchLines := maxInt(1, len(strings.Split(strings.TrimSpace(resolved.Search), "\n")))
+				changedLines := patchChangedLines
+				if float64(changedLines) > float64(searchLines)*limits.MaxChangeRatio && changedLines > 20 {
+					return nil, report, fmt.Errorf("patch %d %s exceeds change-size ratio: %d changed lines for %d search lines", i+1, rel, changedLines, searchLines)
+				}
+			}
+			if resolved.Symbol != "" {
+				report.Methods = appendUnique(report.Methods, normalizedSymbolForReport(resolved.Symbol))
+			}
+			content = updated
+			_ = beforePatch
+		}
+
+		if fileChangedLines > limits.MaxChangedLines {
+			return nil, report, fmt.Errorf("patch safety limit exceeded for %s: %d aggregate changed lines, maximum %d", rel, fileChangedLines, limits.MaxChangedLines)
+		}
+		if fileSearchLines > 0 && fileChangedLines > 20 &&
+			float64(fileChangedLines) > float64(fileSearchLines)*limits.MaxChangeRatio {
+			return nil, report, fmt.Errorf("aggregate change-size ratio exceeded for %s: %d changed lines for %d search lines", rel, fileChangedLines, fileSearchLines)
+		}
+
+		if err := ValidateSemanticDiff(original, content, preparedPatches, rel); err != nil {
+			return nil, report, err
+		}
+		if err := ValidateImportGuard(dir, original, content, preparedPatches, rel); err != nil {
+			return nil, report, err
+		}
+		if err := ValidateGoModGuard(original, content, preparedPatches, rel); err != nil {
+			return nil, report, err
+		}
+		if err := ValidatePublicAPIGuard(original, content, preparedPatches, rel); err != nil {
+			return nil, report, err
+		}
+
+		report.ChangedBytes += len(content) - len(original)
+		mode := os.FileMode(0o644)
+		if info, statErr := os.Stat(target); statErr == nil {
+			mode = info.Mode().Perm()
+		}
+		prepared = append(prepared, preparedChange{Path: rel, Target: target, Data: []byte(content), Mode: mode, Existed: true})
+	}
+
+	return prepared, report, nil
+}
+
+type preparedChange struct {
+	Path    string
+	Target  string
+	Data    []byte
+	Mode    os.FileMode
+	Existed bool
+}
+
+func shortHash(h string) string {
+	if len(h) > 12 {
+		return h[:12]
+	}
+	return h
+}
+
+func patchLineStats(search, replace string) (added, removed int) {
+	removed = 0
+	added = 0
+	if strings.TrimSpace(search) != "" {
+		removed = len(strings.Split(strings.TrimSpace(search), "\n"))
+	}
+	if strings.TrimSpace(replace) != "" {
+		added = len(strings.Split(strings.TrimSpace(replace), "\n"))
+	}
+	return added, removed
+}
+
+func maxInt(a, b int) int {
+	if a > b {
+		return a
+	}
+	return b
+}
+
+func appendUnique(items []string, value string) []string {
+	for _, item := range items {
+		if item == value {
+			return items
+		}
+	}
+	return append(items, value)
+}
+
+func normalizedSymbolForReport(symbol string) string {
+	return normalizePatchSymbol(symbol)
+}
+
+type goSymbolFingerprint struct {
+	Name     string
+	Kind     string
+	Hash     string
+	Exported bool
+}
+
+func collectGoSymbolFingerprints(content string) (map[string]goSymbolFingerprint, error) {
+	content = normalizeNewlines(content)
+	fset := token.NewFileSet()
+	file, err := parser.ParseFile(fset, "semantic.go", []byte(content), parser.ParseComments)
+	if err != nil {
+		return nil, fmt.Errorf("semantic guard cannot parse Go source: %w", err)
+	}
+	out := make(map[string]goSymbolFingerprint)
+	fileInfo := fset.File(file.Pos())
+	if fileInfo == nil {
+		return nil, fmt.Errorf("semantic guard cannot resolve Go positions")
+	}
+
+	for _, decl := range file.Decls {
+		switch d := decl.(type) {
+		case *ast.FuncDecl:
+			name := d.Name.Name
+			if d.Recv != nil && len(d.Recv.List) > 0 {
+				if recv := receiverTypeName(d.Recv.List[0].Type); recv != "" {
+					name = recv + "." + name
+				}
+			}
+			start, end := fileInfo.Offset(d.Pos()), fileInfo.Offset(d.End())
+			out[name] = goSymbolFingerprint{Name: name, Kind: "func", Hash: hashBytes([]byte(normalizeSourceForFingerprint(content[start:end]))), Exported: ast.IsExported(d.Name.Name)}
+		case *ast.GenDecl:
+			for _, spec := range d.Specs {
+				switch s := spec.(type) {
+				case *ast.TypeSpec:
+					if s.Name == nil {
+						continue
+					}
+					start, end := fileInfo.Offset(s.Pos()), fileInfo.Offset(s.End())
+					name := s.Name.Name
+					out[name] = goSymbolFingerprint{Name: name, Kind: "type", Hash: hashBytes([]byte(normalizeSourceForFingerprint(content[start:end]))), Exported: ast.IsExported(s.Name.Name)}
+				case *ast.ValueSpec:
+					for _, id := range s.Names {
+						if id == nil {
+							continue
+						}
+						name := id.Name
+						start, end := fileInfo.Offset(s.Pos()), fileInfo.Offset(s.End())
+						kind := d.Tok.String()
+						out[name] = goSymbolFingerprint{Name: name, Kind: kind, Hash: hashBytes([]byte(normalizeSourceForFingerprint(content[start:end]))), Exported: ast.IsExported(name)}
+					}
+				}
+			}
+		}
+	}
+	return out, nil
+}
+
+func ValidateSemanticDiff(before, after string, patches []domain.Patch, path string) error {
+	if !strings.HasSuffix(strings.ToLower(path), ".go") || len(patches) == 0 {
+		return nil
+	}
+
+	beforeSymbols, err := collectGoSymbolFingerprints(before)
+	if err != nil {
+		return err
+	}
+	afterSymbols, err := collectGoSymbolFingerprints(after)
+	if err != nil {
+		return err
+	}
+
+	allowed := make(map[string]struct{})
+	for _, p := range patches {
+		if p.Symbol != "" {
+			s := normalizePatchSymbol(p.Symbol)
+			allowed[s] = struct{}{}
+			allowed[lastSymbolPart(s)] = struct{}{}
+		}
+		for name := range symbolsFromSnippet(p.Replace) {
+			allowed[name] = struct{}{}
+		}
+	}
+
+	var unexpected []string
+	seen := make(map[string]struct{})
+	for name, beforeFP := range beforeSymbols {
+		afterFP, ok := afterSymbols[name]
+		if !ok || afterFP.Hash != beforeFP.Hash {
+			if _, ok := allowed[name]; !ok {
+				if _, dup := seen[name]; !dup {
+					unexpected = append(unexpected, name)
+					seen[name] = struct{}{}
+				}
+			}
+		}
+	}
+	for name := range afterSymbols {
+		if _, existed := beforeSymbols[name]; existed {
+			continue
+		}
+		if _, ok := allowed[name]; !ok {
+			if _, dup := seen[name]; !dup {
+				unexpected = append(unexpected, name)
+				seen[name] = struct{}{}
+			}
+		}
+	}
+	if len(unexpected) > 0 {
+		sort.Strings(unexpected)
+		return fmt.Errorf("semantic scope guard rejected %s: unexpected symbol changes: %s", path, strings.Join(unexpected, ", "))
+	}
+	return nil
+}
+
+func symbolsFromSnippet(snippet string) map[string]struct{} {
+	out := make(map[string]struct{})
+	snippet = strings.TrimSpace(snippet)
+	if snippet == "" {
+		return out
+	}
+	file, err := parser.ParseFile(token.NewFileSet(), "snippet.go", []byte("package patch\n"+snippet), parser.ParseComments)
+	if err != nil {
+		return out
+	}
+	for _, decl := range file.Decls {
+		switch d := decl.(type) {
+		case *ast.FuncDecl:
+			name := d.Name.Name
+			if d.Recv != nil && len(d.Recv.List) > 0 {
+				if recv := receiverTypeName(d.Recv.List[0].Type); recv != "" {
+					name = recv + "." + name
+				}
+			}
+			out[name] = struct{}{}
+		case *ast.GenDecl:
+			for _, spec := range d.Specs {
+				if ts, ok := spec.(*ast.TypeSpec); ok && ts.Name != nil {
+					out[ts.Name.Name] = struct{}{}
+				}
+			}
+		}
+	}
+	return out
+}
+
+func collectExternalImports(content, modulePrefix string) (map[string]struct{}, error) {
+	file, err := parser.ParseFile(token.NewFileSet(), "imports.go", []byte(normalizeNewlines(content)), parser.ImportsOnly)
+	if err != nil {
+		return nil, err
+	}
+	out := make(map[string]struct{})
+	for _, spec := range file.Imports {
+		path := strings.Trim(spec.Path.Value, "\"")
+		first := path
+		if idx := strings.IndexByte(path, '/'); idx >= 0 {
+			first = path[:idx]
+		}
+		if !strings.Contains(first, ".") {
+			continue
+		}
+		if modulePrefix != "" && (path == modulePrefix || strings.HasPrefix(path, modulePrefix+"/")) {
+			continue
+		}
+		if strings.HasPrefix(path, "internal/") || strings.HasPrefix(path, "vendor/") {
+			continue
+		}
+		out[path] = struct{}{}
+	}
+	return out, nil
+}
+
+func projectModulePrefix(dir string) string {
+	data, err := os.ReadFile(filepath.Join(dir, "go.mod"))
+	if err != nil {
+		return ""
+	}
+	for _, line := range strings.Split(string(data), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 && fields[0] == "module" {
+			return fields[1]
+		}
+	}
+	return ""
+}
+
+func ValidateImportGuard(root, before, after string, patches []domain.Patch, path string) error {
+	if !strings.HasSuffix(strings.ToLower(path), ".go") {
+		return nil
+	}
+	modulePrefix := projectModulePrefix(root)
+	beforeImports, err := collectExternalImports(before, modulePrefix)
+	if err != nil {
+		return fmt.Errorf("import guard parse before %s: %w", path, err)
+	}
+	afterImports, err := collectExternalImports(after, modulePrefix)
+	if err != nil {
+		return fmt.Errorf("import guard parse after %s: %w", path, err)
+	}
+	for imp := range afterImports {
+		if _, exists := beforeImports[imp]; exists {
+			continue
+		}
+		if !replacementMentions(patches, imp) {
+			return fmt.Errorf("import/dependency guard rejected %s: new external import %q is outside the requested patch scope", path, imp)
+		}
+	}
+	return nil
+}
+
+func replacementMentions(patches []domain.Patch, value string) bool {
+	for _, p := range patches {
+		if strings.Contains(p.Replace, value) || strings.Contains(p.Search, value) {
+			return true
+		}
+	}
+	return false
+}
+
+func ValidateGoModGuard(before, after string, patches []domain.Patch, path string) error {
+	if filepath.Base(filepath.Clean(path)) != "go.mod" {
+		return nil
+	}
+	beforeReq := goModRequirements(before)
+	afterReq := goModRequirements(after)
+	for mod := range afterReq {
+		if _, ok := beforeReq[mod]; ok {
+			continue
+		}
+		if !replacementMentions(patches, mod) {
+			return fmt.Errorf("go.mod guard rejected %s: new dependency %q is outside the patch scope", path, mod)
+		}
+	}
+	return nil
+}
+
+func goModRequirements(content string) map[string]struct{} {
+	out := make(map[string]struct{})
+	inRequire := false
+	for _, line := range strings.Split(normalizeNewlines(content), "\n") {
+		trimmed := strings.TrimSpace(line)
+		if strings.HasPrefix(trimmed, "require (") {
+			inRequire = true
+			continue
+		}
+		if inRequire && trimmed == ")" {
+			inRequire = false
+			continue
+		}
+		if strings.HasPrefix(trimmed, "require ") {
+			fields := strings.Fields(strings.TrimPrefix(trimmed, "require "))
+			if len(fields) > 0 && !strings.HasPrefix(fields[0], "//") {
+				out[fields[0]] = struct{}{}
+			}
+			continue
+		}
+		if inRequire {
+			fields := strings.Fields(trimmed)
+			if len(fields) > 0 && !strings.HasPrefix(fields[0], "//") {
+				out[fields[0]] = struct{}{}
+			}
+		}
+	}
+	return out
+}
+
+func collectExportedAPI(content string) (map[string]string, error) {
+	content = normalizeNewlines(content)
+	fset := token.NewFileSet()
+	file, err := parser.ParseFile(fset, "api.go", []byte(content), parser.ParseComments)
+	if err != nil {
+		return nil, err
+	}
+	fi := fset.File(file.Pos())
+	if fi == nil {
+		return nil, fmt.Errorf("cannot resolve API positions")
+	}
+	out := make(map[string]string)
+	for _, decl := range file.Decls {
+		switch d := decl.(type) {
+		case *ast.FuncDecl:
+			if d.Name == nil || !ast.IsExported(d.Name.Name) {
+				continue
+			}
+			name := d.Name.Name
+			if d.Recv != nil && len(d.Recv.List) > 0 {
+				if recv := receiverTypeName(d.Recv.List[0].Type); recv != "" {
+					name = recv + "." + name
+				}
+			}
+			start, end := fi.Offset(d.Pos()), fi.Offset(d.End())
+			text := content[start:end]
+			if idx := strings.IndexByte(text, '{'); idx >= 0 {
+				text = text[:idx]
+			}
+			out[name] = normalizeSourceForFingerprint(text)
+		case *ast.GenDecl:
+			for _, spec := range d.Specs {
+				switch s := spec.(type) {
+				case *ast.TypeSpec:
+					if s.Name == nil || !ast.IsExported(s.Name.Name) {
+						continue
+					}
+					start, end := fi.Offset(s.Pos()), fi.Offset(s.End())
+					out[s.Name.Name] = normalizeSourceForFingerprint(content[start:end])
+				case *ast.ValueSpec:
+					for _, id := range s.Names {
+						if id == nil || !ast.IsExported(id.Name) {
+							continue
+						}
+						start, end := fi.Offset(s.Pos()), fi.Offset(s.End())
+						out[id.Name] = normalizeSourceForFingerprint(content[start:end])
+					}
+				}
+			}
+		}
+	}
+	return out, nil
+}
+
+func ValidatePublicAPIGuard(before, after string, patches []domain.Patch, path string) error {
+	if !strings.HasSuffix(strings.ToLower(path), ".go") {
+		return nil
+	}
+	beforeAPI, err := collectExportedAPI(before)
+	if err != nil {
+		return fmt.Errorf("public API guard parse before %s: %w", path, err)
+	}
+	afterAPI, err := collectExportedAPI(after)
+	if err != nil {
+		return fmt.Errorf("public API guard parse after %s: %w", path, err)
+	}
+	allowed := make(map[string]struct{})
+	for _, p := range patches {
+		if p.Symbol != "" {
+			allowed[normalizePatchSymbol(p.Symbol)] = struct{}{}
+		}
+		for name := range exportedNamesFromSnippet(p.Replace) {
+			allowed[name] = struct{}{}
+		}
+	}
+	var unexpected []string
+	for name, value := range beforeAPI {
+		if next, ok := afterAPI[name]; ok && next != value {
+			if _, ok := allowed[name]; !ok {
+				unexpected = append(unexpected, name)
+			}
+		}
+		if _, ok := afterAPI[name]; !ok {
+			if _, allowed := allowed[name]; !allowed {
+				unexpected = append(unexpected, name+" (removed)")
+			}
+		}
+	}
+	for name := range afterAPI {
+		if _, ok := beforeAPI[name]; ok {
+			continue
+		}
+		if _, allowed := allowed[name]; !allowed {
+			unexpected = append(unexpected, name+" (added)")
+		}
+	}
+	if len(unexpected) > 0 {
+		sort.Strings(unexpected)
+		return fmt.Errorf("public API guard rejected %s: unexpected exported API changes: %s", path, strings.Join(unexpected, ", "))
+	}
+	return nil
+}
+
+func exportedNamesFromSnippet(snippet string) map[string]struct{} {
+	out := make(map[string]struct{})
+	for rawName := range symbolsFromSnippet(snippet) {
+		leaf := rawName
+		if idx := strings.LastIndexByte(rawName, '.'); idx >= 0 {
+			leaf = rawName[idx+1:]
+		}
+		if leaf != "" && ast.IsExported(leaf) {
+			out[rawName] = struct{}{}
+			out[leaf] = struct{}{}
+		}
+	}
+	return out
+}
+
+// AffectedPackageDirs returns the smallest package directories touched by Go changes.
+func AffectedPackageDirs(root string, changes []domain.FileChange) []string {
+	seen := make(map[string]struct{})
+	var dirs []string
+	for _, ch := range changes {
+		if !strings.HasSuffix(strings.ToLower(ch.Path), ".go") {
+			continue
+		}
+		dir := filepath.ToSlash(filepath.Dir(filepath.Clean(ch.Path)))
+		if dir == "" {
+			dir = "."
+		}
+		if _, ok := seen[dir]; ok {
+			continue
+		}
+		seen[dir] = struct{}{}
+		dirs = append(dirs, dir)
+	}
+	if len(dirs) == 0 {
+		return nil
+	}
+	sort.Strings(dirs)
+	return dirs
+}
