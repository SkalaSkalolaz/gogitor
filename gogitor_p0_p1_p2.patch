+package app
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"gogitor/internal/agent"
+	"gogitor/internal/domain"
+	"gogitor/internal/prompts"
+	"gogitor/internal/workspace"
+)
+
+type patchAuditResult struct {
+	Approved         bool   `json:"approved"`
+	ScopeOK          bool   `json:"scope_ok"`
+	SymbolOK         bool   `json:"symbol_ok"`
+	UnrelatedChanges bool   `json:"unrelated_changes"`
+	Reason           string `json:"reason"`
+}
+
+func (s *Service) shouldAuditPatch(opts Options) bool {
+	mode := strings.ToLower(strings.TrimSpace(s.Cfg.PatchAuditorMode))
+	switch mode {
+	case "off":
+		return false
+	case "always":
+		return true
+	}
+
+	// auto: deep-agent runs are always audited; small local models get an extra
+	// safety pass because they use the replace-oriented protocol.
+	if opts.AgentDepth == AgentDepthDeep {
+		return true
+	}
+	size := workspace.ModelParameterCountB(s.Cfg.Model)
+	return size > 0 && size <= 12
+}
+
+func (s *Service) auditPatch(
+	ctx context.Context,
+	task string,
+	projectContext string,
+	changes []domain.FileChange,
+) (patchAuditResult, error) {
+	patchContent := formatPatchContent(changes)
+	if strings.TrimSpace(patchContent) == "" {
+		return patchAuditResult{Approved: true, ScopeOK: true, SymbolOK: true}, nil
+	}
+
+	prompt := prompts.PatchAudit(task, projectContext, patchContent)
+	prompt = s.appendProjectInstructions(prompt)
+
+	var audit patchAuditResult
+	if err := s.sendAgentJSON(
+		ctx,
+		agent.RoleReviewer,
+		agent.PriorityHigh,
+		"patch safety audit",
+		prompt,
+		&audit,
+	); err != nil {
+		return patchAuditResult{}, err
+	}
+
+	if !audit.ScopeOK && strings.TrimSpace(audit.Reason) == "" {
+		audit.Reason = "patch scope rejected by auditor"
+	}
+	if !audit.SymbolOK && strings.TrimSpace(audit.Reason) == "" {
+		audit.Reason = "patch symbol rejected by auditor"
+	}
+	if audit.UnrelatedChanges && strings.TrimSpace(audit.Reason) == "" {
+		audit.Reason = "unrelated changes detected"
+	}
+	if !audit.Approved && strings.TrimSpace(audit.Reason) == "" {
+		audit.Reason = "patch rejected by auditor"
+	}
+
+	return audit, nil
+}
+
+func formatPatchAuditFailure(a patchAuditResult) string {
+	parts := make([]string, 0, 4)
+	if !a.Approved {
+		parts = append(parts, "approved=false")
+	}
+	if !a.ScopeOK {
+		parts = append(parts, "scope_ok=false")
+	}
+	if !a.SymbolOK {
+		parts = append(parts, "symbol_ok=false")
+	}
+	if a.UnrelatedChanges {
+		parts = append(parts, "unrelated_changes=true")
+	}
+	if strings.TrimSpace(a.Reason) != "" {
+		parts = append(parts, a.Reason)
+	}
+	if len(parts) == 0 {
+		return "patch auditor rejected the patch"
+	}
+	return fmt.Sprintf("patch auditor: %s", strings.Join(parts, "; "))
+}
