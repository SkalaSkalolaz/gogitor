+func TestPreparePatchForContentReplaceOnly(t *testing.T) {
+	content := `package main
+
+func main() {
+	println("hello")
+}
+`
+	p := domain.Patch{
+		Symbol:      "main",
+		ReplaceOnly: true,
+		Replace: `func main() {
+	println("world")
+}`,
+	}
+	got, err := PreparePatchForContent(content, p)
+	if err != nil {
+		t.Fatalf("PreparePatchForContent() error = %v", err)
+	}
+	if got.ReplaceOnly {
+		t.Fatal("expected resolved patch to become SEARCH/REPLACE")
+	}
+	if !strings.Contains(got.Search, `println("hello")`) {
+		t.Fatalf("SEARCH did not come from trusted source: %q", got.Search)
+	}
+	if !strings.Contains(got.Replace, `println("world")`) {
+		t.Fatalf("REPLACE was lost: %q", got.Replace)
+	}
+}
