+func TestCaptureProjectSnapshotDetectsStaleChange(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "main.go")
+	original := []byte("package main\n\nfunc main() {}\n")
+	if err := os.WriteFile(path, original, 0o644); err != nil {
