+func codeModifyReplaceOnlyPrompt(task, projectContext, patchPolicy string) string {
+	var b strings.Builder
+	b.WriteString(`You are a senior Go engineer modifying an existing project using SYMBOL-ANCHORED REPLACE_ONLY patches.
+
+TASK:
+`)
