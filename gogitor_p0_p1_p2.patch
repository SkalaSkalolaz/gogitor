+	first := filepath.Join(root, "first.go")
+	second := filepath.Join(root, "second.go")
+	firstBefore := "package main\n\nfunc first() {}\n"
+	secondBefore := "package main\n\nfunc second() {}\n"
+	if err := os.WriteFile(first, []byte(firstBefore), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(second, []byte(secondBefore), 0o644); err != nil {
+		t.Fatal(err)
+	}
