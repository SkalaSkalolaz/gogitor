+func TestPatchProtocolForModel(t *testing.T) {
+	tests := []struct {
+		provider string
+		model    string
+		override string
+		want     PatchProtocol
+	}{
+		{"ollama", "gemma3:4b", "", PatchProtocolReplaceOnly},
+		{"ollama", "gemma4:12b", "", PatchProtocolReplaceOnly},
+		{"ollama", "gpt-oss:20b", "", PatchProtocolSearchReplace},
+		{"openai-compatible+http://localhost:8000/v1", "local", "", PatchProtocolSearchReplace},
+		{"ollama", "gemma3:4b", "search_replace", PatchProtocolSearchReplace},
+		{"ollama", "gpt-oss:20b", "replace_only", PatchProtocolReplaceOnly},
+	}
+	for _, tt := range tests {
+		t.Run(tt.provider+"/"+tt.model+"/"+tt.override, func(t *testing.T) {
+			got := PatchProtocolForModel(tt.provider, tt.model, tt.override)
+			if got != tt.want {
+				t.Fatalf("PatchProtocolForModel() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
