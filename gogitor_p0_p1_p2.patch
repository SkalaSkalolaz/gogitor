+// findRebasedBlock uses a unique semantic anchor from SEARCH to relocate an otherwise
+// stale block before we consider fuzzy matching. It is intentionally local and deterministic.
+func findRebasedBlock(origLines, searchLines []string) *fuzzyBlockMatch {
+	if len(searchLines) == 0 {
+		return nil
+	}
+	frequency := make(map[string]int)
+	for _, line := range origLines {
+		key := normalizeLineForCompare(line)
+		if strings.TrimSpace(key) != "" {
+			frequency[key]++
+		}
+	}
+
+	anchorIndex := -1
+	for i, line := range searchLines {
+		key := normalizeLineForCompare(line)
+		if strings.TrimSpace(key) != "" && frequency[key] == 1 {
+			anchorIndex = i
+			break
+		}
+	}
+	if anchorIndex < 0 {
+		return nil
+	}
+
+	var best *fuzzyBlockMatch
+	for pos, line := range origLines {
+		if normalizeLineForCompare(line) != normalizeLineForCompare(searchLines[anchorIndex]) {
+			continue
+		}
+		start := pos - anchorIndex
+		if start < 0 || start >= len(origLines) {
+			continue
+		}
+		end := start + len(searchLines)
+		if end > len(origLines) {
+			end = len(origLines)
+		}
+		candidate := origLines[start:end]
+		candidateText := strings.Join(candidate, "\n")
+		searchText := strings.Join(searchLines, "\n")
+
+		// Never rebase a declaration onto a different declaration identity.
+		// This prevents e.g. `func nonexistent` from rebasing onto `func main`.
+		if !sameGoDeclarationIdentity(searchText, candidateText) {
+			continue
+		}
+
+		// Rebase is deliberately conservative: the unique anchor must also
+		// preserve most source lines. Otherwise the operation belongs to
+		// the later fuzzy stage (or must be rejected).
+		if normalizedLineSimilarity(searchLines, candidate) < 0.72 {
+			continue
+		}
+
+		// If Go tokens are identical, the mismatch is comments/whitespace only.
+		// Exact/relaxed/normalized stages should own those cases; do not let rebase
+		// turn a low-confidence comment mismatch into a successful patch.
+		if multisetMapsEqual(goTokenMultiset(candidateText), goTokenMultiset(searchText)) {
+			continue
+		}
+		score := tokenMultisetSimilarity(candidateText, searchText)
+		if score < 0.60 {
+			continue
+		}
+		if best == nil || score > best.Similarity {
+			best = &fuzzyBlockMatch{StartLine: start, EndLine: end, Similarity: score}
+		}
+	}
+	return best
+}
+
+type fuzzyBlockMatch struct {
+	StartLine  int
+	EndLine    int
+	Similarity float64
+	SecondBest float64
+}
+
+// findASTAwareBlock compares token structure of AST nodes instead of raw lines.
+func findASTAwareBlock(content, search string, symbolStart, symbolEnd int) *fuzzyBlockMatch {
+	search = strings.TrimSpace(normalizeNewlines(search))
+	if search == "" {
+		return nil
+	}
+
+	// Full declarations have a stronger identity rule and are handled by
+	// exact/normalized matching or Symbol validation. AST fuzzy must never
+	// silently replace one named declaration with another one.
+	if looksLikeGoDeclaration(search) {
+		return nil
+	}
+	targetTokens := goTokenMultiset(search)
+	if len(targetTokens) == 0 {
+		return nil
+	}
+
+	fset := token.NewFileSet()
+	file, err := parser.ParseFile(fset, "ast-fuzzy.go", []byte(content), parser.ParseComments)
+	if err != nil {
+		return nil
+	}
+	fi := fset.File(file.Pos())
+	if fi == nil {
+		return nil
+	}
+
+	best := &fuzzyBlockMatch{StartLine: -1}
+	second := 0.0
+	ast.Inspect(file, func(node ast.Node) bool {
+		if node == nil {
+			return true
+		}
+		switch node.(type) {
+		case *ast.FuncDecl, *ast.GenDecl, *ast.TypeSpec, *ast.BlockStmt,
+			*ast.IfStmt, *ast.ForStmt, *ast.RangeStmt, *ast.SwitchStmt,
+			*ast.ReturnStmt, *ast.ExprStmt, *ast.AssignStmt, *ast.DeclStmt,
+			*ast.GoStmt, *ast.DeferStmt, *ast.SendStmt, *ast.IncDecStmt, *ast.LabeledStmt:
+		default:
+			return true
+		}
+		start := fi.Offset(node.Pos())
+		end := fi.Offset(node.End())
+		if start < symbolStart || end > symbolEnd || end <= start {
+			return true
+		}
+
+		nodeText := content[start:end]
+		lineStart := fset.Position(node.Pos()).Line - 1
+		lineEnd := fset.Position(node.End()).Line
+		if lineEnd < lineStart {
+			return true
+		}
+
+		candidateTokens := goTokenMultiset(nodeText)
+		score := multisetSimilarity(targetTokens, candidateTokens)
+		if score < 0.68 {
+			return true
+		}
+
+		if best.StartLine < 0 || score > best.Similarity {
+			second = best.Similarity
+			best = &fuzzyBlockMatch{StartLine: lineStart, EndLine: lineEnd, Similarity: score, SecondBest: second}
+		} else if score > second {
+			second = score
+		}
+		return true
+	})
+	if best.StartLine < 0 {
+		return nil
+	}
+	best.SecondBest = second
+	return best
+}
+
+func normalizedLineSimilarity(a, b []string) float64 {
+	if len(a) == 0 || len(a) != len(b) {
+		return 0
+	}
+	matched := 0
+	for i := range a {
+		if normalizeLineForCompare(a[i]) == normalizeLineForCompare(b[i]) {
+			matched++
+		}
+	}
+	return float64(matched) / float64(len(a))
+}
+
+func looksLikeGoDeclaration(src string) bool {
+	file, err := parser.ParseFile(
+		token.NewFileSet(),
+		"snippet.go",
+		[]byte("package patch\n"+strings.TrimSpace(normalizeNewlines(src))),
+		parser.ParseComments,
+	)
+	if err != nil || len(file.Decls) == 0 {
+		return false
+	}
+	switch file.Decls[0].(type) {
+	case *ast.FuncDecl:
+		return true
+	case *ast.GenDecl:
+		d := file.Decls[0].(*ast.GenDecl)
+		return d.Tok == token.TYPE
+	default:
+		return false
+	}
+}
+
+func sameGoDeclarationIdentity(search, candidate string) bool {
+	if !looksLikeGoDeclaration(search) {
+		return true
+	}
+	parse := func(src string) ast.Decl {
+		file, err := parser.ParseFile(
+			token.NewFileSet(),
+			"snippet.go",
+			[]byte("package patch\n"+strings.TrimSpace(normalizeNewlines(src))),
+			parser.ParseComments,
+		)
+		if err != nil || len(file.Decls) == 0 {
+			return nil
+		}
+		return file.Decls[0]
+	}
+
+	a := parse(search)
+	b := parse(candidate)
+	if a == nil || b == nil {
+		return false
+	}
+
+	funcName := func(fn *ast.FuncDecl) string {
+		name := fn.Name.Name
+		if fn.Recv != nil && len(fn.Recv.List) > 0 {
+			if recv := receiverTypeName(fn.Recv.List[0].Type); recv != "" {
+				name = recv + "." + name
+			}
+		}
+		return name
+	}
+
+	switch x := a.(type) {
+	case *ast.FuncDecl:
+		y, ok := b.(*ast.FuncDecl)
+		return ok && funcName(x) == funcName(y)
+	case *ast.GenDecl:
+		y, ok := b.(*ast.GenDecl)
+		if !ok || x.Tok != y.Tok || x.Tok != token.TYPE {
+			return false
+		}
+		xs, _ := x.Specs[0].(*ast.TypeSpec)
+		ys, _ := y.Specs[0].(*ast.TypeSpec)
+		return xs != nil && ys != nil && xs.Name != nil && ys.Name != nil && xs.Name.Name == ys.Name.Name
+	default:
+		return true
+	}
+}
+
+func goTokenMultiset(src string) map[string]int {
+	var s scanner.Scanner
+	fset := token.NewFileSet()
+	file := fset.AddFile("tokens.go", -1, len(src))
+	s.Init(file, []byte(src), nil, 0)
+	out := make(map[string]int)
+	for {
+		_, tok, lit := s.Scan()
+		if tok == token.EOF {
+			break
+		}
+		if lit == "" {
+			lit = tok.String()
+		}
+		out[tok.String()+":"+lit]++
+	}
+	return out
+}
+
+func multisetMapsEqual(a, b map[string]int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if b[k] != v {
+			return false
+		}
+	}
+	return true
+}
+
+func tokenMultisetSimilarity(a, b string) float64 {
+	return multisetSimilarity(goTokenMultiset(a), goTokenMultiset(b))
+}
+
+func multisetSimilarity(a, b map[string]int) float64 {
+	if len(a) == 0 && len(b) == 0 {
+		return 1
+	}
+	if len(a) == 0 || len(b) == 0 {
+		return 0
+	}
+	common := 0
+	totalA := 0
+	totalB := 0
+	for k, n := range a {
+		totalA += n
+		if m := b[k]; m < n {
+			common += m
+		} else {
+			common += n
+		}
+	}
+	for _, n := range b {
+		totalB += n
+	}
+	if totalA+totalB == 0 {
+		return 0
+	}
+	return 2 * float64(common) / float64(totalA+totalB)
+}
