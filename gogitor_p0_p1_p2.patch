+++ b/internal/workspace/patch_safety.go
@@ -0,0 +1,1252 @@
+package workspace
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/scanner"
+	"go/token"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"gogitor/internal/domain"
+	"gogitor/internal/security"
+)
+
+// PatchProtocol controls the syntax requested from the coding model.
+// SearchReplace preserves the legacy SEARCH/REPLACE protocol.
+// ReplaceOnly lets Gogitor derive SEARCH from a trusted Symbol/AST range.
+type PatchProtocol int
+
+const (
+	PatchProtocolSearchReplace PatchProtocol = iota
+	PatchProtocolReplaceOnly
+)
+
+func (p PatchProtocol) String() string {
+	if p == PatchProtocolReplaceOnly {
+		return "replace_only"
+	}
+	return "search_replace"
+}
+
+func ParsePatchProtocol(s string) (PatchProtocol, bool) {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "replace_only", "replace-only", "symbol_replace", "symbol-replace":
+		return PatchProtocolReplaceOnly, true
+	case "search_replace", "search-replace", "legacy":
+		return PatchProtocolSearchReplace, true
+	default:
+		return PatchProtocolSearchReplace, false
+	}
+}
+
+// ModelParameterCountB exposes the model-size heuristic already used by policy selection.
+func ModelParameterCountB(model string) float64 {
+	return modelParameterCountB(model)
+}
+
+// PatchProtocolForModel chooses the safer model-facing patch protocol.
+// Small local models do not have to reproduce old source text byte-for-byte.
+func PatchProtocolForModel(provider, model, override string) PatchProtocol {
+	if p, ok := ParsePatchProtocol(override); ok {
+		return p
+	}
+
+	provider = strings.ToLower(strings.TrimSpace(provider))
+	model = strings.ToLower(strings.TrimSpace(model))
+
+	if strings.HasPrefix(provider, "openai+") ||
+		strings.HasPrefix(provider, "openai-compatible+") ||
+		strings.Contains(model, "cloud") {
+		return PatchProtocolSearchReplace
+	}
+
+	if size := modelParameterCountB(model); size > 0 && size <= 12 {
+		return PatchProtocolReplaceOnly
+	}
+
+	return PatchProtocolSearchReplace
+}
+
+// PatchSafetyLimits are hard deterministic limits. They are deliberately policy-based
+// so the safety layer does not depend on an LLM-generated value.
+type PatchSafetyLimits struct {
+	MaxBlocksPerFile int
+	MaxChangedLines  int
+	MaxChangeRatio   float64
+}
+
+func patchSafetyLimits(policy PatchPolicy) PatchSafetyLimits {
+	switch policy {
+	case PatchPolicyStrict:
+		return PatchSafetyLimits{MaxBlocksPerFile: 5, MaxChangedLines: 160, MaxChangeRatio: 20}
+	case PatchPolicyAdvanced:
+		return PatchSafetyLimits{MaxBlocksPerFile: 12, MaxChangedLines: 640, MaxChangeRatio: 35}
+	default:
+		return PatchSafetyLimits{MaxBlocksPerFile: 8, MaxChangedLines: 320, MaxChangeRatio: 25}
+	}
+}
+
+// CaptureSnapshot hashes source files before the LLM result is applied.
+func (w *Workspace) CaptureSnapshot(paths []string) (map[string]string, error) {
+	out := make(map[string]string, len(paths))
+	for _, rel := range paths {
+		rel = filepath.Clean(strings.TrimSpace(rel))
+		if rel == "." || rel == "" {
+			continue
+		}
+		full, err := security.SafeJoin(w.Root, rel)
+		if err != nil {
+			return nil, err
+		}
+		data, err := os.ReadFile(full)
+		if err != nil {
+			if os.IsNotExist(err) {
+				continue
+			}
+			return nil, fmt.Errorf("snapshot %s: %w", rel, err)
+		}
+		out[rel] = hashBytes(data)
+	}
+	return out, nil
+}
+
+// BindSourceSnapshots attaches trusted source versions to generated changes.
+// Unknown files are hashed at parse time; known context files use the earlier snapshot.
+func (w *Workspace) BindSourceSnapshots(
+	changes []domain.FileChange,
+	snapshot map[string]string,
+) ([]domain.FileChange, error) {
+	bound := make([]domain.FileChange, len(changes))
+	copy(bound, changes)
+
+	for i := range bound {
+		rel := filepath.Clean(bound[i].Path)
+		full, err := security.SafeJoin(w.Root, rel)
+		if err != nil {
+			return nil, err
+		}
+
+		trustedHash, expectedPresent := snapshot[rel]
+		data, readErr := os.ReadFile(full)
+		if readErr != nil {
+			if os.IsNotExist(readErr) {
+				if expectedPresent {
+					// The file existed when the model started, but disappeared meanwhile.
+					// Preserve the original hash so preflight cannot turn a stale update
+					// into an accidental file creation.
+					bound[i].SourceHash = trustedHash
+					bound[i].ExpectedPresent = true
+				} else {
+					bound[i].ExpectedAbsent = true
+				}
+				if len(bound[i].Patches) > 0 {
+					return nil, fmt.Errorf("patch target does not exist: %s", bound[i].Path)
+				}
+				continue
+			}
+			return nil, fmt.Errorf("cannot snapshot %s: %w", bound[i].Path, readErr)
+		}
+
+		fileHash := trustedHash
+		if fileHash == "" {
+			fileHash = hashBytes(data)
+		}
+		bound[i].SourceHash = fileHash
+		bound[i].ExpectedPresent = true
+
+		for j := range bound[i].Patches {
+			bound[i].Patches[j].ExpectedSourceHash = fileHash
+			if strings.TrimSpace(bound[i].Patches[j].Symbol) != "" {
+				fp, err := SymbolFingerprint(string(data), bound[i].Patches[j].Symbol)
+				if err != nil {
+					return nil, fmt.Errorf("%s symbol %q: %w", bound[i].Path, bound[i].Patches[j].Symbol, err)
+				}
+				bound[i].Patches[j].ExpectedSymbolFingerprint = fp
+			}
+		}
+	}
+
+	return bound, nil
+}
+
+// CaptureProjectSnapshot hashes the complete working tree that Gogitor may mutate.
+// This closes the race where a generated patch targets a file that was not among
+// the explicitly named target files.
+func (w *Workspace) CaptureProjectSnapshot() (map[string]string, error) {
+	out := make(map[string]string)
+	err := filepath.Walk(w.Root, func(path string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		if info.IsDir() {
+			if shouldSkipDir(info.Name()) {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if shouldSkipFile(info.Name()) {
+			return nil
+		}
+		rel, err := filepath.Rel(w.Root, path)
+		if err != nil {
+			return err
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return fmt.Errorf("snapshot %s: %w", rel, err)
+		}
+		out[filepath.Clean(rel)] = hashBytes(data)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+func hashBytes(data []byte) string {
+	h := sha256.Sum256(data)
+	return hex.EncodeToString(h[:])
+}
+
+func fileHash(path string) (string, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return "", err
+	}
+	return hashBytes(data), nil
+}
+
+// SymbolFingerprint is a deterministic optimistic-concurrency fingerprint of one AST symbol.
+func SymbolFingerprint(content, symbol string) (string, error) {
+	start, end, err := findSymbolRange(content, symbol)
+	if err != nil {
+		return "", err
+	}
+	return hashBytes([]byte(normalizeSourceForFingerprint(content[start:end]))), nil
+}
+
+func normalizeSourceForFingerprint(s string) string {
+	return strings.Join(strings.Fields(normalizeNewlines(s)), " ")
+}
+
+// PreparePatchForContent converts the model-friendly replace-only form into a classic
+// exact SEARCH/REPLACE patch using current trusted source text.
+func PreparePatchForContent(content string, p domain.Patch) (domain.Patch, error) {
+	if !p.ReplaceOnly {
+		return p, nil
+	}
+	if strings.TrimSpace(p.Symbol) == "" {
+		return domain.Patch{}, fmt.Errorf("replace-only patch requires Symbol")
+	}
+	start, end, err := findSymbolRange(content, p.Symbol)
+	if err != nil {
+		return domain.Patch{}, err
+	}
+	if strings.TrimSpace(p.Replace) == "" {
+		return domain.Patch{}, fmt.Errorf("replace-only patch has empty REPLACE content")
+	}
+	if err := validateReplacementSymbol(p.Replace, p.Symbol); err != nil {
+		return domain.Patch{}, err
+	}
+	p.Search = content[start:end]
+	p.ReplaceOnly = false
+	return p, nil
+}
+
+func validateReplacementSymbol(replace, symbol string) error {
+	replace = strings.TrimSpace(normalizeNewlines(replace))
+	if replace == "" {
+		return fmt.Errorf("empty replacement for symbol %q", symbol)
+	}
+
+	file, err := parser.ParseFile(token.NewFileSet(), "replacement.go", []byte("package patch\n"+replace), parser.ParseComments)
+	if err != nil {
+		return fmt.Errorf("replacement for symbol %q is not valid Go: %w", symbol, err)
+	}
+
+	want := normalizePatchSymbol(symbol)
+	for _, decl := range file.Decls {
+		switch d := decl.(type) {
+		case *ast.FuncDecl:
+			name := d.Name.Name
+			if d.Recv != nil && len(d.Recv.List) > 0 {
+				if recv := receiverTypeName(d.Recv.List[0].Type); recv != "" {
+					name = recv + "." + name
+				}
+			}
+			if name == want || d.Name.Name == want {
+				return nil
+			}
+		case *ast.GenDecl:
+			if d.Tok == token.TYPE {
+				for _, spec := range d.Specs {
+					if ts, ok := spec.(*ast.TypeSpec); ok && ts.Name != nil && (ts.Name.Name == want || ts.Name.Name == lastSymbolPart(want)) {
+						return nil
+					}
+				}
+			}
+		}
+	}
+	return fmt.Errorf("replacement does not define requested symbol %q", symbol)
+}
+
+func lastSymbolPart(symbol string) string {
+	parts := strings.Split(normalizePatchSymbol(symbol), ".")
+	if len(parts) == 0 {
+		return symbol
+	}
+	return parts[len(parts)-1]
+}
+
+// PreflightChanges performs the deterministic safety layer without mutating files.
+func (w *Workspace) PreflightChanges(
+	dir string,
+	changes []domain.FileChange,
+	policy PatchPolicy,
+	minConfidenceOverride float64,
+) (*PatchPreflightReport, error) {
+	prepared, report, err := w.prepareChanges(dir, changes, policy, minConfidenceOverride)
+	_ = prepared
+	return report, err
+}
+
+type PatchPreflightReport struct {
+	Files        int
+	PatchFiles   int
+	PatchBlocks  int
+	ChangedLines int
+	ChangedBytes int
+	Methods      []string
+	Warnings     []string
+}
+
+func (w *Workspace) prepareChanges(
+	dir string,
+	changes []domain.FileChange,
+	policy PatchPolicy,
+	minConfidenceOverride float64,
+) ([]preparedChange, *PatchPreflightReport, error) {
+	if len(changes) == 0 {
+		return nil, nil, fmt.Errorf("no changes to apply")
+	}
+
+	limits := patchSafetyLimits(policy)
+	report := &PatchPreflightReport{Files: len(changes)}
+	prepared := make([]preparedChange, 0, len(changes))
+	seen := make(map[string]struct{}, len(changes))
+
+	for _, ch := range changes {
+		rel := filepath.Clean(strings.TrimSpace(ch.Path))
+		if rel == "" || rel == "." {
+			return nil, report, fmt.Errorf("invalid empty change path")
+		}
+		if _, ok := seen[rel]; ok {
+			return nil, report, fmt.Errorf("duplicate file change for %q", ch.Path)
+		}
+		seen[rel] = struct{}{}
+
+		target, err := security.SafeJoin(dir, rel)
+		if err != nil {
+			return nil, report, err
+		}
+
+		before, readErr := os.ReadFile(target)
+		exists := readErr == nil
+		if readErr != nil && !os.IsNotExist(readErr) {
+			return nil, report, fmt.Errorf("cannot read %s: %w", rel, readErr)
+		}
+
+		if ch.ExpectedPresent && !exists {
+			return nil, report, fmt.Errorf("stale patch: %s disappeared after patch generation", rel)
+		}
+		if ch.SourceHash != "" {
+			if !exists {
+				return nil, report, fmt.Errorf("stale patch: %s disappeared after patch generation", rel)
+			}
+			actual := hashBytes(before)
+			if actual != ch.SourceHash {
+				return nil, report, fmt.Errorf("stale patch: %s source changed (expected %s, got %s)", rel, shortHash(ch.SourceHash), shortHash(actual))
+			}
+		}
+		if ch.ExpectedAbsent && exists {
+			return nil, report, fmt.Errorf("stale create: %s appeared after patch generation", rel)
+		}
+		if len(ch.Patches) > 0 && !exists {
+			return nil, report, fmt.Errorf("patch target does not exist: %s", rel)
+		}
+		if len(ch.Patches) > limits.MaxBlocksPerFile {
+			return nil, report, fmt.Errorf("patch safety limit exceeded for %s: %d blocks, maximum %d", rel, len(ch.Patches), limits.MaxBlocksPerFile)
+		}
+
+		if len(ch.Patches) == 0 {
+			if strings.TrimSpace(ch.Content) == "" {
+				return nil, report, fmt.Errorf("empty content for %s", rel)
+			}
+			mode := os.FileMode(0o644)
+			if exists {
+				if info, statErr := os.Stat(target); statErr == nil {
+					mode = info.Mode().Perm()
+				}
+			}
+			prepared = append(prepared, preparedChange{Path: rel, Target: target, Data: []byte(normalizeNewlines(ch.Content)), Mode: mode, Existed: exists})
+			continue
+		}
+
+		report.PatchFiles++
+		report.PatchBlocks += len(ch.Patches)
+		content := normalizeNewlines(string(before))
+		original := content
+		preparedPatches := make([]domain.Patch, len(ch.Patches))
+		copy(preparedPatches, ch.Patches)
+		fileChangedLines := 0
+		fileSearchLines := 0
+
+		// Verify all source/symbol fingerprints against the immutable source snapshot
+		// BEFORE the first patch mutates this in-memory file. Multiple patches may target
+		// the same symbol and are therefore allowed to change its fingerprint afterwards.
+		actualFileHash := hashBytes(before)
+		for i, raw := range preparedPatches {
+			if raw.ExpectedSourceHash != "" && exists && raw.ExpectedSourceHash != actualFileHash {
